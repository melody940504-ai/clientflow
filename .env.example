DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSLMODE=require
SESSION_SECRET=replace-with-a-long-random-value
RUN_DB_MIGRATIONS=true

RESEND_API_KEY=re_your_key
EMAIL_TEST_RECIPIENT=
# Keep the default for Resend testing. Replace it with a verified-domain address later.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_key
# Keep enabled after running scripts/configure_private_attachments.py.
ATTACHMENTS_BUCKET_PRIVATE=true
MAX_VIDEO_UPLOAD_MB=250
MAX_ATTACHMENT_UPLOAD_MB=25

# Optional shared rate limiting for multiple Render instances.
# A Redis or Valkey URL can be added later without changing application code.
REDIS_URL=

DEMO_ENABLED=true
DEMO_OWNER_EMAIL=melody940504+demo@gmail.com
DEMO_CLIENT_EMAIL=demo.client@example.com

# Leave disabled in production unless you are actively diagnosing connectivity.
ENABLE_DB_TEST=0
